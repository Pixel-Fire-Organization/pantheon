# Ensure shell scripts always use LF so they work in WSL/Linux
*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# CMake and source files
*.cmake text eol=lf
CMakeLists.txt text eol=lf
# Generated TrenchBroom FGD: keep LF so the build-time regenerate + copy_if_different
# is a no-op on a clean tree (the generator always writes LF).
*.fgd text eol=lf
# Default: normalize to LF on all platforms
* text=auto
# Git LFS: large binary formats (textures, vendored TrenchBroom binaries)
# Patterns are case-sensitive on Linux (core.ignorecase defaults to false there,
# unlike Windows/macOS): both cases are listed explicitly for every extension
# that actually appears both ways in the tree, or a checkout on a case-sensitive
# runner silently skips the LFS smudge and leaves the raw pointer text as the
# "asset".
*.png filter=lfs diff=lfs merge=lfs -text
*.PNG filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.JPG filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.JPEG filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text
