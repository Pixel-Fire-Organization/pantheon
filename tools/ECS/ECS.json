{
  "$schema": "./schema.json",
  "hooks": [
    "HurtEntity",
    "UnlockDoor",
    "LockDoor",
    "ButtonPressed"
  ],
  "components": [
    {
      "name": "HealthComponent",
      "description": "Handles entity vitality",
      "properties": [
        {
          "name": "max_health",
          "type": "int",
          "description": "Maximum health",
          "default": 100
        }
      ],
      "actions": [
        {
          "name": "hurtPlayer",
          "engineHook": "HurtEntity"
        }
      ]
    },
    {
      "name": "CollisionComponent",
      "description": "Handles physics layers",
      "properties": [
        {
          "name": "layer_mask",
          "type": "flags",
          "description": "Collision layers this entity interacts with",
          "default": 1,
          "options": {
            "1": "WORLD",
            "2": "PLAYER",
            "4": "ENEMY"
          }
        }
      ]
    },
    {
      "name": "TransformComponent",
      "description": "Handles Transform of an entity/object",
      "properties": [
        {
          "name": "position",
          "type": "string",
          "description": "Position of the entity/object",
          "default": "0.0 0.0 0.0"
        },
        {
          "name": "angles",
          "type": "string",
          "description": "Rotation of the entity/object",
          "default": "0 0 0"
        },
        {
          "name": "scale",
          "type": "string",
          "description": "Scale of the entity/object",
          "default": "1.0 1.0 1.0"
        }
      ]
    },
    {
      "name": "ModelComponent",
      "description": "Handles 3D mesh rendering",
      "properties": [
        {
          "name": "model",
          "type": "studio",
          "description": "Path to the 3D model file",
          "default": "models/barrel.mdl"
        },
        {
          "name": "is_static",
          "type": "bool",
          "description": "Is the model static?",
          "default": true
        }
      ]
    },
    {
      "name": "ButtonComponent",
      "description": "Used by func_button",
      "actions": [
        {
          "name": "buttonPressed",
          "engineHook": "ButtonPressed"
        }
      ]
    },
    {
      "name": "LevelComponent",
      "description": "Carries info about a level. Used by func_changeLevel",
      "properties": [
        {
          "name": "level_name",
          "type": "string",
          "description": "The name of the next level to be loaded",
          "default": ""
        },
        {
          "name": "wait_time",
          "type": "int",
          "description": "Time in seconds that the level will be loaded after. 0 is immediate",
          "default": 0
        },
        {
          "name": "args",
          "type": "string",
          "description": "Space separated arguments that will be passed to the scene.",
          "default": ""
        }
      ]
    },
    {
      "name": "DoorComponent",
      "description": "Has info, used by func_door",
      "properties": [
        {
          "name": "door_weight",
          "type": "float",
          "description": "The door's weight. The heavier the door, the more force it will need to open it.",
          "default": 1.0
        },
        {
          "name": "is_locked",
          "type": "bool",
          "description": "Is the door locked? If so, the door will not open.",
          "default": false
        }
      ],
      "actions": [
        {
          "name": "unlockDoor",
          "engineHook": "UnlockDoor"
        },
        {
          "name": "lockDoor",
          "engineHook": "LockDoor"
        }
      ]
    },
    {
      "name": "DetailComponent",
      "description": "Marks structural brushes as detail, and optionally controls LOD1 generation.",
      "properties": [
        {
          "name": "include_in_lod1",
          "type": "bool",
          "description": "If false, this detail brush will be stripped from the LOD1 low-poly mesh.",
          "default": false
        }
      ]
    },
    {
      "name": "WorldComponent",
      "description": "Global map compilation settings. Only evaluated at compile-time by compile_level.py.",
      "properties": [
        {
          "name": "_map_scale",
          "type": "float",
          "description": "World scale factor. Quake units (QU) to Engine meters (EM). e.g., 0.03125 EM for 1 QU = 1/32 EM.",
          "default": 0.03125
        },
        {
          "name": "_sector_size",
          "type": "float",
          "description": "Streaming grid cell size in EM. Determines streaming chunk granularity.",
          "default": 32.0
        },
        {
          "name": "_max_edge",
          "type": "float",
          "description": "Max triangle edge length in EM. Prevents large polygons from vanishing abruptly on PS2.",
          "default": 16.0
        }
      ]
    }
  ],
  "entities": [
    {
      "classname": "prop_barrel",
      "classType": "PointClass",
      "description": "An explosive barrel",
      "components": [
        "HealthComponent",
        "CollisionComponent",
        "ModelComponent"
      ]
    },
    {
      "classname": "prop_model",
      "classType": "PointClass",
      "description": "An static model",
      "components": [
        "TransformComponent",
        "CollisionComponent",
        "ModelComponent"
      ]
    },
    {
      "classname": "func_button",
      "classType": "SolidClass",
      "description": "An interactive button",
      "components": [
        "ButtonComponent"
      ]
    },
    {
      "classname": "func_changeLevel",
      "classType": "SolidClass",
      "description": "A trigger that will change the level on player interaction",
      "components": [
        "LevelComponent"
      ]
    },
    {
      "classname": "func_door",
      "classType": "SolidClass",
      "description": "Door that can be interacted by a player, NPCs or other physics objecs",
      "components": [
        "CollisionComponent"
      ]
    },
    {
      "classname": "func_detail",
      "classType": "SolidClass",
      "description": "Decorative brushwork that does not cut BSP leaves. Dropped from LOD1 unless include_in_lod1 is true.",
      "components": [
        "DetailComponent"
      ]
    },
    {
      "classname": "worldspawn",
      "classType": "SolidClass",
      "description": "The base world geometry. Holds global map properties.",
      "components": [
        "WorldComponent"
      ]
    }
  ]
}